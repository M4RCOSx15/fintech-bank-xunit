## .gitignore para projetos .NET 10 (C#)

# --- IDEs e editores ---
.idea/
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# --- Saídas de build ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/

# --- Testes e cobertura ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
TestResults/
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
*.runsettings.user

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
.nuget/

# --- .NET diversos ---
*.dll.config
*.pdb
*.mdb
*.cache
*.log
*.tmp
*.tmp_proj
*.binlog
*_i.c
*_p.c
*.ilk
*.obj
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
launchSettings.json.user
msbuild.log
msbuild.err
msbuild.wrn

# --- JetBrains Rider ---
*.sln.iml
.idea_modules/

# --- Segredos locais ---
appsettings.Development.json
secrets.json
*.pfx

# --- Sistema operacional ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
